# Local development without Docker (npm run dev -w backend). Never commit .env.
DB_CLIENT=sqlite
SQLITE_PATH=../data/private-space.db
STORAGE_DIR=../storage
# For PostgreSQL instead:
# DB_CLIENT=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/private_space
PORT=3000
COOKIE_SECURE=false
TRUST_PROXY=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
LINK_PREVIEWS=true
