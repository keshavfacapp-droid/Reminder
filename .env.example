# Copy to .env and fill in. NEVER commit .env.

# Public host name of your server (DNS must point here), or "localhost" for testing.
DOMAIN=localhost
# Your e-mail address to get free public HTTPS certificates (Let's Encrypt/ZeroSSL),
# or "internal" for localhost / LAN-only installs (Caddy's own local CA).
TLS_MODE=internal

# Database password — generate one with:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Web Push (VAPID) keys — generate with:
#   docker compose run --rm backend node dist/scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Sessions
SESSION_IDLE_HOURS=168
SESSION_ABSOLUTE_DAYS=30

# Upload limits (MB). Keep MAX_REQUEST_BODY a bit above the largest.
MAX_PHOTO_MB=30
MAX_VIDEO_MB=500
MAX_DOCUMENT_MB=100
MAX_REQUEST_BODY=600MB

# Fetch page titles for shared links (server-side, SSRF-protected, no images).
LINK_PREVIEWS=true

# Host ports
HTTP_PORT=80
HTTPS_PORT=443
